---
import MainLayout from "../layouts/MainLayout.astro";

const lastUpdated = "August 10, 2026";

const sections = [
	{
		title: "1. Acceptance of Terms",
		body: "By accessing or using the services provided by Polygon Payments LLC (\"Polygon Payments\", \"we\", \"us\", or \"our\"), you agree to be bound by these Terms of Service. If you do not agree to these terms, you may not use our services.",
	},
	{
		title: "2. Use of Services",
		body: "You agree to use our payment processing and related services only for lawful purposes and in accordance with these terms. You are responsible for ensuring that your use of the services complies with all applicable laws, regulations, and card network rules.",
	},
	{
		title: "3. Accounts and Eligibility",
		body: "To use certain features, you may be required to provide accurate and complete business information. You are responsible for maintaining the confidentiality of your account credentials and for all activity that occurs under your account.",
	},
	{
		title: "4. Fees and Payments",
		body: "Fees for our services are described in your service agreement or pricing schedule. All fees are due as outlined in that agreement. We reserve the right to modify our fees with reasonable notice.",
	},
	{
		title: "5. Prohibited Activities",
		body: "You may not use our services to process transactions related to illegal activities, fraud, money laundering, or any business category prohibited by our banking partners or card networks.",
	},
	{
		title: "6. Limitation of Liability",
		body: "To the maximum extent permitted by law, Polygon Payments shall not be liable for any indirect, incidental, special, or consequential damages arising out of or related to your use of our services.",
	},
	{
		title: "7. Termination",
		body: "We may suspend or terminate your access to the services at any time if you violate these terms or if required by our banking partners, card networks, or applicable law.",
	},
	{
		title: "8. Changes to These Terms",
		body: "We may update these Terms of Service from time to time. Continued use of the services after changes take effect constitutes acceptance of the revised terms.",
	},
	{
		title: "9. Contact Us",
		body: "If you have any questions about these Terms of Service, please contact us at contact@polygonpayments.com or +1 (888) 536-6002.",
	},
];
---

<MainLayout title="Terms of Service">
	<main class="space-y-20">
		<div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-3">
			<div class="space-y-6">
				<h1 class="text-5xl font-medium leading-none md:text-6xl">
					Terms of Service
				</h1>
				<p class="text-lg text-gray-600">Last updated: {lastUpdated}</p>
			</div>

			<div class="mt-12 space-y-10">
				{
					sections.map((section) => (
						<section class="space-y-3">
							<h2 class="text-2xl font-medium leading-tight md:text-3xl">
								{section.title}
							</h2>
							<p class="text-lg font-normal leading-7">{section.body}</p>
						</section>
					))
				}
			</div>
		</div>
	</main>
</MainLayout>
