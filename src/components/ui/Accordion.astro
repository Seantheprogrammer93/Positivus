---
import AccordionItem from "./AccordionItem.astro";

const content = [
{
  index: 1,
  title: "Apply for a Merchant Account",
  description: "The first step in the process is to apply for a merchant account. This will allow you to accept payments from customers and manage your transactions. Our team will assist you in selecting the right payment processor and completing the application process."
},
{
  index: 2,
  title: "Wait for Approval",
  description: "After submitting your application, you will need to wait for approval from the payment processor. This step involves a review of your business information and compliance with industry regulations."
},
{
  index: 3,
  title: "Start Processing Payments",
  description: "Once your merchant account is approved, you can start processing payments. Our team will assist you in integrating the payment processor with your website or point-of-sale system to ensure smooth and secure transactions."
},
];
---

{
  content.map((item) => {
    return (
      <AccordionItem
        index={item.index}
        title={item.title}
        description={item.description}
      />
    );
  })
}
