---
import { Image } from "astro:assets";
import Instagram2 from "../../assets/instagram2.svg";
import Linkedin from "../../assets/linkedin.svg";
import Logo from "../../assets/logo-alt.svg";

const logos = [
  { name: "Instagram", src: Instagram2, link: "https://www.instagram.com/polygon_payments/" },
  { name: "Linkedin", src: Linkedin, link: "https://www.linkedin.com/company/polygon-payments-llc" },
];

const links = [
  { name: "About us", href: "/about" },
  { name: "Services", href: "/services" },
  { name: "Use Cases", href: "/cases" },
  { name: "Pricing", href: "/pricing" },
  { name: "Blog", href: "/articles" },
  { name: "Terms of Service", href: "/terms" },
  { name: "Acceptable Use Policy", href: "/acceptable-use" },
  { name: "Privacy Policy", href: "/privacy" },
];

const currentYear = new Date().getFullYear();
---

<section class="sm:px-5">
  <div class="w-full max-w-[1240px] mx-auto">
    <div
      class="px-[15px] bg-dark text-gray py-[55px] lg:px-[60px] sm:rounded-t-[45px]"
    >
      <div>
        <div
          class="flex flex-col lg:flex-row gap-7 items-center justify-center"
        >
          <picture>
            <a href="#home">
              <Image src={Logo} alt="Logo for Polygon Payments" />
            </a>
          </picture>
          <ul class="flex gap-5">
            {
              logos.map((logo) => {
                return (
                  <li>
                    <a href={logo.link} target="_blank">
                      <picture>
                        <Image src={logo.src} alt={logo.name} />
                      </picture>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </div>

        <ul class="flex flex-col sm:flex-row flex-wrap justify-center gap-5 mt-9">
          {
            links.map((link) => {
              return (
                <li class="text-center">
                  <a class="underline" href={link.href}>
                    {link.name}
                  </a>
                </li>
              );
            })
          }
        </ul>

        <div class="flex flex-col mt-[66px] mb-[51px] items-center">
          <div class="flex text-center flex-col">
            <h3 class="mb-5 text-2xl text-green">
              Contact us
            </h3>
            <div class="flex flex-col justify-between gap-4">
              <span> Email: contact@polygonpayments.com </span>
              <span> Phone: +1 (888) 536-6002 </span>
            </div>
          </div>
        </div>
      </div>

      <div class="h-[1px] bg-gray mb-5"></div>
      <div
        class="flex flex-col lg:flex-row h-20 justify-center mt-4 text-center md:justify-between md:mt-0"
      >
        <span>© {currentYear} Polygon Payments LLC. Polygon Payments LLC is an agent of Humboldt Merchant Services, Eureka, California. Humboldt Merchant Services is a registered ISO of BMO Harris N.A., Chicago, IL. Humboldt Merchant Services is a registered DBA of EPX, a registered ISO of BMO Harris Bank N.A., Chicago, IL, and FFB Bank, Fresno, CA.</span>
      </div>
    </div>
  </div>
</section>
