---
import { Image } from "astro:assets";
import Card from "../ui/Card.astro";
import Section from "./Section.astro";

import propImg from "../../assets/pics/proposal-pic.png";
---

<Section>
  <Card>
    <div
      class="flex bg-[#F3F3F3] rounded-[45px] p-[60px] relative mt-[123px] mb-[163px]"
    >
      <div class="w-full md:w-[40%] flex flex-col gap-[26px]">
        <h2 class="text-3xl font-medium">Don't worry about shutdowns or frozen funds anymore</h2>
        <p>
          Apply for a Polygon Payments account today and enjoy uninterrupted access to your funds, even during unexpected shutdowns. Our platform is designed to keep your business running smoothly, so you can focus on what matters most - growing your business.
        </p>
        <button class="btn-primary"><a href="/pricing">Apply Now</a></button>
      </div>
      <picture
        class="hidden md:flex absolute right-[-10%] lg:right-0 top-[-15%] h-[450px] items-center justify-center"
      >
        <Image
          src={propImg}
          alt="This is an illustration"
          class="hidden md:flex lg:h-full lg:w-auto"
        />
      </picture>
    </div>
  </Card>
</Section>
