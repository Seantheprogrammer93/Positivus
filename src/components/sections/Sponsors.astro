---
import { Image } from "astro:assets";
import s1 from "../../assets/company/company-logo1.svg";
import s2 from "../../assets/company/company-logo2.svg";
import Section from "./Section.astro";

const sponsors = [
  { logo: s2, alt: "Publish Bio logo", url: "https://www.publish.bio" },
  { logo: s1, alt: "Unicheckout logo", url: "https://www.unicheckout.com" },
];
---

<Section id="sponsors">
  <div class="flex-row items-center">
  <h2 class="text-2xl font-bold text-center mb-8">Our Other Brands</h2>
  <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-2">
    {
      sponsors.map((sponsor) => {
        return (
          <a
            href={sponsor.url}
            target="_blank"
            rel="noopener noreferrer"
            class="block p-4 grayscale transition duration-200 hover:grayscale-0"
          >
            <Image src={sponsor.logo} class="h-12 w-auto mx-auto" alt={sponsor.alt} loading="lazy" />
          </a>
        );
      })
    }
  </div>
  </div> 
</Section>